#!/usr/bin/env bash
# Wardrobe 启动脚本：./wardrobe start | stop | status | backup | restore <zip> | --help
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v uv >/dev/null 2>&1; then
  echo "需要先安装 uv：brew install uv" >&2
  exit 1
fi

# macOS 上 .venv 内的 .pth 文件可能带 hidden 标记而被 Python 忽略，因此显式指定包路径
export PYTHONPATH="$DIR/backend${PYTHONPATH:+:$PYTHONPATH}"
exec uv run --project "$DIR/backend" --quiet python -m wardrobe.cli "$@"
